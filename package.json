{
  "name": "civ5-typings-monorepo",
  "private": true,
  "author": "Cat Core",
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter civ5-typings build",
    "scrape": "pnpm --filter civ5-scraper scrape",
    "scrape:api": "pnpm --filter civ5-scraper scrape:api",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter civ5-example typecheck"
  },
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  }
}
