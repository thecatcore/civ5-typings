{
  "include": ["main.ts", "api.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": true,
    // Node runs this file directly by stripping its types.
    "erasableSyntaxOnly": true,
    "strict": true,
    "skipLibCheck": true
  }
}
